---
type Props = {
  eyebrow?: string;
  title: string;
  titleHighlight?: string;
  description: string;
  cta?: { label: string; href: string };
  withPortrait?: boolean;
};

const { eyebrow, title, titleHighlight, description, cta, withPortrait = false } = Astro.props;
---

<section class="relative overflow-hidden border-b border-white/5">
  <div class="site-container py-20 md:py-28 grid grid-cols-1 md:grid-cols-[1fr_320px] gap-10 items-end">
    <div>
      {eyebrow && (
        <p class="font-sans text-gray-400 text-xs md:text-sm tracking-[0.2em] uppercase mb-6 flex items-center gap-3">
          <span class="inline-block w-3 h-3 bg-neon-lime rounded-full animate-pulse"></span>
          {eyebrow}
        </p>
      )}
      <h1 class="font-display text-[3rem] sm:text-5xl md:text-[80px] xl:text-[100px] leading-[1.05] md:leading-[0.95] tracking-tight text-white uppercase">
        {title}
        {titleHighlight && (<><br /><span class="text-neon-lime">{titleHighlight}</span></>)}
      </h1>
      <p class="mt-8 max-w-2xl font-sans text-base md:text-lg leading-relaxed text-gray-300">
        {description}
      </p>
      {cta && (
        <a
          href={cta.href}
          class="mt-8 inline-flex items-center bg-neon-lime px-6 py-4 font-display text-sm md:text-base uppercase text-deep-black hover:bg-white transition-colors"
        >
          {cta.label}
        </a>
      )}
    </div>
    {withPortrait && (
      <img
        src="/img/joris-portrait.webp"
        alt="Joris Balluais, freelance SEO à Rennes, fondateur de JOKTA"
        width="320"
        height="320"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="hidden md:block w-full aspect-square object-cover border border-white/10 grayscale"
      />
    )}
  </div>
</section>
