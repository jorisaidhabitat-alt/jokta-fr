---
type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Un projet en tête ?",
  description = "Discutons-en. Réponse sous 24 heures, du lundi au vendredi.",
} = Astro.props;
---

<section class="py-20 md:py-28 bg-neon-lime text-deep-black">
  <div class="site-container flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div>
      <h2 class="font-display text-3xl md:text-5xl uppercase mb-2">{title}</h2>
      <p class="max-w-xl">{description}</p>
    </div>
    <a href="/contact/" class="inline-flex items-center bg-deep-black text-neon-lime px-6 py-4 font-display text-sm uppercase hover:bg-white hover:text-deep-black transition-colors">
      Passer à l'action →
    </a>
  </div>
</section>
