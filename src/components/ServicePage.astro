---
import type { ServiceItem } from '../data/services';

type Props = { service: ServiceItem };

const { service } = Astro.props;
---

<section class="border-b border-white/5 py-20 md:py-28">
  <div class="site-container">
    <p class="font-display text-xs uppercase tracking-widest text-neon-lime mb-3">{service.shortTitle}</p>
    <h1 class="font-display text-4xl md:text-6xl text-white uppercase max-w-3xl">{service.title}</h1>
    <p class="mt-6 max-w-2xl text-xl text-white/80">{service.tagline}</p>
    <p class="mt-6 max-w-3xl text-white/70 leading-relaxed">{service.description}</p>
  </div>
</section>

<section class="border-b border-white/5 py-20">
  <div class="site-container grid grid-cols-1 md:grid-cols-2 gap-12">
    <div>
      <h2 class="font-display text-2xl md:text-3xl text-white uppercase mb-6">Ce qui est inclus</h2>
      <ul class="space-y-3 text-white/85">
        {service.benefits.map((b) => (
          <li class="flex gap-3"><span class="text-neon-lime">→</span>{b}</li>
        ))}
      </ul>
    </div>
    <div>
      <div class="bg-white/5 border border-white/10 p-7">
        <div class="font-display text-xs uppercase tracking-widest text-white/50 mb-2">Tarif</div>
        <p class="text-white/90 mb-6">{service.pricing}</p>
        <div class="font-display text-xs uppercase tracking-widest text-white/50 mb-2">Délai</div>
        <p class="text-white/90 mb-6">{service.duration}</p>
        <a href="/contact/" class="inline-flex items-center bg-neon-lime px-6 py-3 font-display text-sm uppercase text-deep-black hover:bg-white transition-colors">
          Demander un devis
        </a>
      </div>
    </div>
  </div>
</section>
