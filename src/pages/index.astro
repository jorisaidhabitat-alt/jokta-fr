---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import SeoSeaComplement from '../components/SeoSeaComplement.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
import { TESTIMONIALS } from '../data/testimonials';

const title = "Freelance SEO à Rennes | JOKTA – SEO, SEA & création de sites web";
const description = "Joris Balluais, freelance SEO à Rennes. J'aide les entreprises à générer plus de demandes entrantes grâce au SEO, au SEA et à des sites web orientés conversion. Audit gratuit.";

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.ownerName,
  jobTitle: 'Freelance SEO',
  url: SITE.url,
  email: SITE.email,
  telephone: SITE.phone,
  worksFor: { '@type': 'Organization', name: SITE.name },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    addressCountry: 'FR',
  },
  sameAs: [SITE.social.linkedin, SITE.social.instagram],
  knowsAbout: ['SEO', 'SEA', 'Référencement naturel', 'Google Ads', 'Création de site web'],
};

const aggregateRating = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 5,
    bestRating: 5,
    worstRating: 1,
    ratingCount: TESTIMONIALS.length,
    reviewCount: TESTIMONIALS.length,
  },
};

const reviewSchemas = TESTIMONIALS.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'ProfessionalService',
    name: SITE.name,
    url: SITE.url,
  },
  author: { '@type': 'Person', name: t.author },
  reviewBody: t.quote,
  reviewRating: {
    '@type': 'Rating',
    ratingValue: t.rating,
    bestRating: 5,
    worstRating: 1,
  },
}));

const serviceSchemas = SERVICES.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  url: `${SITE.url}/${s.slug}/`,
  description: s.description,
  provider: {
    '@type': 'ProfessionalService',
    name: SITE.name,
    url: SITE.url,
  },
  areaServed: 'France',
}));

const jsonLd = [personSchema, aggregateRating, ...reviewSchemas, ...serviceSchemas];
---

<Layout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={jsonLd}>
  <Hero
    eyebrow="Freelance Expert SEO — Rennes"
    title="Freelance SEO à Rennes"
    titleHighlight="Plus de demandes entrantes"
    description="Je transforme les données complexes en stratégies de croissance concrètes. SEO, SEA et création de sites web pensés pour générer des contacts qualifiés, pas du trafic creux."
    cta={{ label: "Demander un audit gratuit", href: "/contact/" }}
    withPortrait
  />

  <ServicesGrid />

  <SeoSeaComplement />

  <Pricing />

  <Testimonials />

  <CtaBanner />
</Layout>
