---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { SITE } from '../../data/site';

const title = "Blog SEO, SEA et création web | JOKTA";
const description = "Réflexions, retours d'expérience et conseils pratiques sur le SEO, le SEA et la création de sites web.";

// Static placeholder posts — to be replaced by Sanity fetch
const posts = [
  {
    slug: 'vibecoding',
    title: 'Le vibecoding, ou comment construire vite sans sacrifier la qualité',
    excerpt: "Retour d'expérience sur la méthode de développement rapide qui combine prototypage et exécution maîtrisée.",
    date: '2026-06-04',
  },
];

const dateFormat = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={title} description={description}>
  <section class="border-b border-white/5 py-20 md:py-28">
    <div class="site-container">
      <p class="font-display text-xs uppercase tracking-widest text-neon-lime mb-3">Blog</p>
      <h1 class="font-display text-4xl md:text-6xl text-white uppercase max-w-3xl">Réflexions & retours d'expérience</h1>
      <p class="mt-6 max-w-2xl text-xl text-white/80">
        Des billets concrets sur le SEO, le SEA et la création de sites web. Pas de théorie creuse, juste ce qui marche.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="site-container">
      {posts.length === 0 ? (
        <p class="text-white/70">Il n'y a pas encore d'article disponible. Revenez bientôt !</p>
      ) : (
        <ul class="space-y-6">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`} class="group block bg-white/5 border border-white/10 p-7 hover:border-neon-lime/50 hover:bg-white/10 transition-all">
                <div class="font-display text-xs uppercase tracking-widest text-white/50 mb-2">
                  <time datetime={post.date}>{dateFormat.format(new Date(post.date))}</time>
                </div>
                <h2 class="font-display text-2xl text-white uppercase group-hover:text-neon-lime transition-colors">{post.title}</h2>
                <p class="mt-3 text-white/80">{post.excerpt}</p>
                <div class="mt-4 text-sm font-display uppercase tracking-widest text-neon-lime">Lire l'article →</div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <CtaBanner />
</Layout>
