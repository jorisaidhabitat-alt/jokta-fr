---
import Layout from '../../layouts/Layout.astro';
import ServicePage from '../../components/ServicePage.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { SERVICES } from '../../data/services';
import { SITE } from '../../data/site';

const service = SERVICES.find((s) => s.slug === 'seo')!;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  url: `${SITE.url}/seo/`,
  description: service.description,
  provider: { '@type': 'ProfessionalService', name: SITE.name, url: SITE.url },
  areaServed: ['Rennes', 'Bretagne', 'France'],
  offers: { '@type': 'Offer', priceCurrency: 'EUR' },
};

const title = "Référencement naturel SEO à Rennes | JOKTA";
const description = "Améliorez durablement votre visibilité sur Google : audit technique, stratégie de contenu, netlinking et optimisation On-page par un freelance SEO à Rennes.";
---

<Layout title={title} description={description} jsonLd={serviceSchema}>
  <ServicePage service={service} />
  <CtaBanner title="Prêt à reprendre la main sur votre SEO ?" />
</Layout>
