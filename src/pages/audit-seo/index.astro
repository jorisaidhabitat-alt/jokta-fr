---
import Layout from '../../layouts/Layout.astro';
import ServicePage from '../../components/ServicePage.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { SERVICES } from '../../data/services';
import { SITE } from '../../data/site';

const service = SERVICES.find((s) => s.slug === 'audit-seo')!;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  url: `${SITE.url}/audit-seo/`,
  description: service.description,
  provider: { '@type': 'ProfessionalService', name: SITE.name, url: SITE.url },
  areaServed: ['Rennes', 'Bretagne', 'France'],
};

const title = "Audit SEO complet à Rennes | JOKTA";
const description = "Audit technique, sémantique et concurrentiel de votre site. Livrable clair, recommandations priorisées et roadmap actionnable pour passer à l'exécution.";
---

<Layout title={title} description={description} jsonLd={serviceSchema}>
  <ServicePage service={service} />
  <CtaBanner title="Envie d'un état des lieux clair ?" description="Recevez un audit complet et actionnable." />
</Layout>
